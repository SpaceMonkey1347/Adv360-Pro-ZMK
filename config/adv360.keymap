#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        mo_tog: mo_tog {
            compatible = "zmk,behavior-hold-tap";
            label = "MO_TOG";
            #binding-cells = <2>;
            bindings = <&mo>, <&tog>;

            tapping-term-ms = <200>;
        };
    };

    combos {
        compatible = "zmk,combos";

        jk_LGUI {
            bindings = <&kp LGUI>;
            key-positions = <52 67>;
            layers = <0 1 2 3>;
        };

        jk_RGUI {
            bindings = <&kp RGUI>;
            key-positions = <68 53>;
            layers = <0 1 2 3>;
        };

        jk_LGUI_mirror {
            bindings = <&kp LGUI>;
            key-positions = <68 53>;
            layers = <5>;
        };

        jk_RGUI_mirror {
            bindings = <&kp RGUI>;
            key-positions = <52 67>;
            layers = <5>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &tog 2                                                   &mo 6    &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &to 0                                                    &to 0    &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &to 1      &kp LCTRL  &kp LALT      &kp RALT  &kp RCTRL  &to 1    &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                         &tog 5        &tog 5                        &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo 3      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp SPACE  &kp ENTER  &mo 5         &mo 5     &kp BSPC   &kp DEL          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &mo 3
            >;
        };

        gaming {
            bindings = <
&kp EQUAL   &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &tog 2                                                    &mo 6    &kp N6  &kp N7    &kp N8     &kp N9     &kp N0    &kp MINUS
&kp TAB     &kp T      &kp Q     &kp W     &kp E      &kp R   &to 0                                                     &to 0    &kp Y   &kp U     &kp UP     &kp O      &kp P     &kp BSLH
&kp ESC     &kp G      &kp A     &kp S     &kp D      &kp F   &to 1      &kp LCTRL  &kp LALT      &kp RALT   &kp RCTRL  &to 1    &kp H   &kp LEFT  &kp DOWN   &kp RIGHT  &kp SEMI  &kp SQT
&kp LSHIFT  &kp Z      &kp X     &kp C     &kp V      &kp B                         &tog 5        &kp HOME                       &kp N   &kp M     &kp COMMA  &kp DOT    &kp FSLH  &kp RSHFT
&mo 3       &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp SPACE  &kp ENTER  &mo 5         &lt 5 END  &kp BSPC   &kp DEL          &kp UP    &kp DOWN   &kp LBKT   &kp RBKT  &mo 3
            >;
        };

        left_keypad {
            bindings = <
&trans  &kp KP_MULTIPLY  &kp KP_SLASH  &kp KP_EQUAL  &kp KP_NUM  &trans  &trans                                           &mo 6   &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp KP_MINUS     &kp KP_N7     &kp KP_N8     &kp KP_N9   &trans  &to 0                                            &to 0   &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp KP_PLUS      &kp KP_N4     &kp KP_N5     &kp KP_N6   &trans  &to 1     &trans     &trans      &trans  &trans  &to 1   &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp KP_ENTER     &kp KP_N1     &kp KP_N2     &kp KP_N3   &trans                       &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp KP_DOT       &kp KP_N0     &trans        &trans              &kp BSPC  &kp ENTER  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;

            label = "Kp";
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 2                                           &mo 6   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &to 0                                            &to 0   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &to 1   &trans  &trans         &trans    &trans  &to 1   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &kp PG_UP      &kp HOME                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &kp PG_DN      &kp END   &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        fn_mirror {
            display-name = "Fn";
            bindings = <
&kp F12  &kp F11  &kp F10  &kp F9  &kp F8  &kp F7  &tog 2                                           &mo 6   &kp F6  &kp F5  &kp F4  &kp F3  &kp F2  &kp F1
&trans   &trans   &trans   &trans  &trans  &trans  &to 0                                            &to 0   &trans  &trans  &trans  &trans  &trans  &trans
&trans   &trans   &trans   &trans  &trans  &trans  &to 1   &trans  &trans        &trans     &trans  &to 1   &trans  &trans  &trans  &trans  &trans  &trans
&trans   &trans   &trans   &trans  &trans  &trans                  &kp HOME      &kp PG_UP                  &trans  &trans  &trans  &trans  &trans  &trans
&trans   &trans   &trans   &trans  &trans          &trans  &trans  &kp END       &kp PG_DN  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        mirror {
            bindings = <
&kp MINUS  &kp N0    &kp N9    &kp N8     &kp N7  &kp N6  &tog 2                                                       &mo 6      &kp N5  &kp N4    &kp N3     &kp N2    &kp N1     &kp EQUAL
&kp BSLH   &kp P     &kp O     &kp I      &kp U   &kp Y   &to 0                                                        &to 0      &kp T   &kp R     &kp E      &kp W     &kp Q      &kp TAB
&kp SQT    &kp SEMI  &kp L     &kp K      &kp J   &kp H   &to 1     &kp RCTRL  &kp RALT      &kp LALT       &kp LCTRL  &to 1      &kp G   &kp F     &kp D      &kp S     &kp A      &kp ESC
&kp RSHFT  &kp FSLH  &kp DOT   &kp COMMA  &kp M   &kp N                        &kp HOME      &kp PG_UP                            &kp B   &kp V     &kp C      &kp X     &kp Z      &kp LSHFT
&mo 4      &kp LBKT  &kp RBKT  &kp DOWN   &kp UP          &kp BSPC  &kp DEL    &kp END       &kp PAGE_DOWN  &kp ENTER  &kp SPACE          &kp LEFT  &kp RIGHT  &kp CAPS  &kp GRAVE  &mo 4
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };
    };
};
